
# Cổng chạy server (mặc định 5000 nếu bỏ trống)
PORT=5000

# Chuỗi kết nối MongoDB
# Local:  mongodb://localhost:27017/novaphone
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/novaphone
MONGO_URI=mongodb://localhost:27017/novaphone

# Chuỗi bí mật để ký JWT — đổi thành chuỗi ngẫu nhiên dài, không share công khai
JWT_SECRET=change_this_to_a_long_random_secret

# Domain frontend được phép gọi API (CORS) khi deploy production
# Ví dụ: https://phone-store.vercel.app
CLIENT_URL=

# URL webhook n8n dùng cho chatbot tư vấn AI (tùy chọn — bỏ trống nếu chưa dùng)
N8N_CHAT_WEBHOOK_URL=
