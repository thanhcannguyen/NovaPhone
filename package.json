{
  "name": "novaphone",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "build:web": "npm run build -w apps/web",
    "start:api": "npm run start -w apps/api",
    "seed:api": "npm run seed -w apps/api",
    "lint:web": "npm run lint -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}